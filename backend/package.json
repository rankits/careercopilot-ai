{
  "name": "@careercopilot/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start:dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "worker:email": "tsx src/workers/run-email-worker.ts",
    "worker:email:build": "node dist/workers/run-email-worker.js",
    "worker:outbox": "tsx src/workers/run-outbox-relay.ts",
    "worker:outbox:build": "node dist/workers/run-outbox-relay.js",
    "worker:job-embeddings": "tsx src/workers/run-job-embedding-worker.ts",
    "worker:job-embeddings:build": "node dist/workers/run-job-embedding-worker.js",
    "worker:resume-analysis": "tsx src/workers/run-resume-analysis-worker.ts",
    "worker:resume-analysis:build": "node dist/workers/run-resume-analysis-worker.js",
    "job-embeddings:backfill": "tsx src/modules/job-embeddings/cli/run-job-embedding-backfill.ts",
    "job-embeddings:backfill:build": "node dist/modules/job-embeddings/cli/run-job-embedding-backfill.js",
    "jobs:cleanup:storage-retention": "tsx src/modules/jobs/cli/run-storage-retention-cleanup.ts",
    "jobs:cleanup:embedding-age": "tsx src/modules/jobs/cli/run-embedding-age-cleanup.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run integration.test.ts",
    "format:check": "prettier --check .",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx src/seed.ts",
    "prisma:seed:build": "node dist/seed.js",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@langchain/core": "^1.2.3",
    "@langchain/google-genai": "^2.2.0",
    "@prisma/client": "^6.3.0",
    "amqplib": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.4",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-http": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.9",
    "@types/nodemailer": "^6.4.17",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prisma": "^6.3.0",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^4.1.10"
  }
}
