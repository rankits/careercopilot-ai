{
    "name": "@careercopilot/backend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
        "start": "node dist/server.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src --max-warnings=0",
        "lint:fix": "eslint src --fix",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1097.0",
        "@prisma/client": "^6.3.0",
        "amqplib": "^2.0.1",
        "bcrypt": "^5.1.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^5.0.1",
        "helmet": "^8.0.0",
        "hpp": "^0.2.3",
        "ioredis": "^5.11.1",
        "jsonwebtoken": "^9.0.2",
        "mammoth": "^1.12.0",
        "multer": "^2.2.0",
        "pdf-parse": "^2.4.5",
        "pino": "^10.3.1",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@types/amqplib": "^0.10.8",
        "@types/bcrypt": "^5.0.2",
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/hpp": "^0.2.6",
        "@types/jsonwebtoken": "^9.0.8",
        "@types/multer": "^2.2.0",
        "@types/node": "^22.10.9",
        "@types/pdf-parse": "^1.1.5",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^16.4.0",
        "pino-pretty": "^13.1.3",
        "prisma": "^6.3.0",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.35.1",
        "vitest": "^4.1.10"
    }
}
