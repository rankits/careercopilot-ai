# Development Dockerfile for @careercopilot/backend
FROM node:20-alpine

# OpenSSL is required by Prisma query engine on Alpine Linux
RUN apk add --no-cache openssl curl

WORKDIR /app

# Cache dependency installation & Prisma client generation layer
COPY package*.json ./
COPY prisma ./prisma

RUN npm install && npx prisma generate

# Copy source code
COPY . .

RUN chmod +x docker/entrypoint.sh

EXPOSE 5001

ENTRYPOINT ["/app/docker/entrypoint.sh"]
CMD ["npm", "run", "dev"]
