# Production Multi-Stage Dockerfile for @careercopilot/backend

# --- Stage 1: Base ---
FROM node:20-alpine AS base
RUN apk add --no-cache openssl curl su-exec
WORKDIR /app

# --- Stage 2: Dependencies & Prisma Generation ---
FROM base AS deps
COPY package*.json ./
COPY prisma.config.ts ./
COPY prisma ./prisma
COPY prisma.config.ts ./prisma.config.ts
RUN npm ci && npx prisma generate

# --- Stage 3: TypeScript Build ---
FROM deps AS build
COPY . .
RUN npm run build

# --- Stage 4: Production Dependencies ---
FROM deps AS production-deps
RUN npm prune --omit=dev

# --- Stage 5: Minimal Production Runtime ---
FROM base AS production

COPY package*.json ./
COPY prisma.config.ts ./
COPY prisma ./prisma
COPY prisma.config.ts ./prisma.config.ts
COPY docker/entrypoint.sh ./docker/entrypoint.sh
RUN npm ci --include=dev && npx prisma generate
COPY --from=production-deps /app/node_modules ./node_modules

COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma/migrations ./prisma/migrations

RUN mkdir -p /app/storage/resumes \
  && chown -R node:node /app \
  && chmod +x docker/entrypoint.sh

ENV NODE_ENV=production
ENV PORT=5001

EXPOSE 5001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:5001/api/v1/status || exit 1

ENTRYPOINT ["/app/docker/entrypoint.sh"]
CMD ["node", "dist/server.js"]
