// Identity is split into two independent principals - `Admin` (platform
// operators, provisioned via seed, password-only auth) and `User` (self
// service job seekers, email-OTP-gated registration/login) - each with its
// own credential ("Meta") and session table. Both share the same Role/
// Permission RBAC engine so `shared/middlewares/rbac.middleware.ts` works
// uniformly across principal types.
//
// Internal primary keys are sequential integers (fast joins/indexes);
// the ONLY identifier ever exposed externally (JWT `sub`, API responses,
// route params) - this avoids enumeration of sequential ids while keeping
// internal query performance.

// -----------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------

enum Status {
  PendingVerification @map("pending_verification")
  Active              @map("active")
  Suspended           @map("suspended")
  Deactivated         @map("deactivated")

  @@map("status")
}

enum OtpPurpose {
  Registration  @map("registration")
  Login         @map("login")
  PasswordReset @map("password_reset")

  @@map("otp_purpose")
}

enum OtpTransport {
  Email  @map("email")
  Mobile @map("mobile")

  @@map("otp_transport")
}

enum AuditAction {
  Register               @map("register")
  LoginSuccess           @map("login_success")
  LoginFailed            @map("login_failed")
  Logout                 @map("logout")
  LogoutAll              @map("logout_all")
  OtpRequested           @map("otp_requested")
  OtpVerified            @map("otp_verified")
  OtpFailed              @map("otp_failed")
  PasswordResetRequested @map("password_reset_requested")
  PasswordResetSuccess   @map("password_reset_success")
  PasswordChanged        @map("password_changed")
  ProfileUpdated         @map("profile_updated")
  AccountLocked          @map("account_locked")
  AccountUnlocked        @map("account_unlocked")
  TokenRefreshed         @map("token_refreshed")
  TokenReuseDetected     @map("token_reuse_detected")

  @@map("audit_action")
}

// -----------------------------------------------------------------------
// RBAC (shared by Admin and User)
// -----------------------------------------------------------------------

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  admins      Admin[]
  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          Int     @id @default(autoincrement())
  /// Canonical dot-separated permission string, e.g. "user.profile.update.own"
  key         String  @unique
  resource    String
  action      String
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// -----------------------------------------------------------------------
// Admin (platform operators - provisioned via seed, password-only auth)
// -----------------------------------------------------------------------

model Admin {
  id       Int    @id @default(autoincrement())

  firstName    String  @map("first_name")
  lastName     String  @map("last_name")
  email        String  @unique
  profileImage String? @map("profile_image")
  status       Status  @default(Active)

  roleId Int  @map("role_id")
  role   Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// Bumped on password change/logout-all so previously issued access
  /// tokens (which embed this value as a claim) are rejected immediately.
  tokenVersion Int @default(0) @map("token_version")

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  lastLoginIp         String?   @map("last_login_ip")

  meta      AdminMeta?
  sessions  AdminSession[]
  auditLogs AuditLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([roleId])
  @@index([status])
  @@map("admins")
}

/// Credentials live in a separate 1:1 table so the frequently-selected
/// `Admin` row never needs to project (or accidentally leak via a loose
/// `select *`) the password hash/salt.
model AdminMeta {
  adminId      Int    @id @map("admin_id")
  passwordHash String @map("password_hash")
  passwordSalt String @map("password_salt")

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_meta")
}

model AdminSession {
  id      Int   @id @default(autoincrement())
  adminId Int   @map("admin_id")
  admin   Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  /// SHA-256 hash of the raw refresh token; the raw value is only ever
  /// returned to the client once (at issuance) and is never persisted.
  sessionId String @unique @map("session_id")

  /// Shared by a token and everything it gets rotated into, so a reused
  /// (already-rotated) token can revoke its whole lineage in one query -
  /// a strong signal the token was stolen.
  familyId String @map("family_id")

  rememberMe Boolean @default(false) @map("remember_me")
  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")

  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedBySessionId String?   @map("replaced_by_session_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([familyId])
  @@map("admin_sessions")
}

// -----------------------------------------------------------------------
// User (self-service job seekers - email OTP registration/login)
// -----------------------------------------------------------------------

model User {
  id       Int    @id @default(autoincrement())

  firstName    String  @map("first_name")
  lastName     String  @map("last_name")
  email        String  @unique
  phone        String?
  profileImage String? @map("profile_image")
  bio          String?

  status          Status  @default(PendingVerification)
  isEmailVerified Boolean @default(false) @map("is_email_verified")

  roleId Int  @map("role_id")
  role   Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  tokenVersion Int @default(0) @map("token_version")

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  lastLoginIp         String?   @map("last_login_ip")

  meta      UserMeta?
  sessions  UserSession[]
  auditLogs AuditLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([roleId])
  @@index([status])
  @@map("users")
}

model UserMeta {
  userId       Int    @id @map("user_id")
  passwordHash String @map("password_hash")
  passwordSalt String @map("password_salt")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_meta")
}

model UserSession {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String @unique @map("session_id")
  familyId  String @map("family_id")

  rememberMe Boolean @default(false) @map("remember_me")
  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")

  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedBySessionId String?   @map("replaced_by_session_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("user_sessions")
}

// -----------------------------------------------------------------------
// OTP (Postgres-backed: durable, auditable, no Redis dependency for
// correctness - Redis is still used for rate limiting / tokenVersion /
// permission caching, see infrastructure/cache)
// -----------------------------------------------------------------------

model Otp {
  id Int @id @default(autoincrement())

  /// SHA-256 hash of the code - the plaintext code is never persisted.
  code      String
  purpose   OtpPurpose
  transport OtpTransport @default(Email)
  /// Email address (or mobile number, for a future SMS transport).
  target    String

  /// Lifetime resend counter for this (transport, target, purpose); once
  /// it crosses a configured ceiling the row is permanently `blocked` as
  /// an abuse guard, independent of the short-lived per-request rate
  /// limiter in front of the HTTP endpoint.
  attempt Int @default(1) @db.SmallInt
  /// Incorrect verification attempts against the CURRENT code; reset to 0
  /// whenever a new code is issued.
  retries Int @default(0) @db.SmallInt

  lastSentAt       DateTime @default(now()) @map("last_sent_at")
  expiresAt        DateTime @map("expires_at")
  /// True once this exact code has been successfully verified, so it
  /// cannot be replayed a second time.
  lastCodeVerified Boolean  @default(false) @map("last_code_verified")
  blocked          Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([transport, target, purpose])
  @@map("otp")
}

// -----------------------------------------------------------------------
// Audit
// -----------------------------------------------------------------------

model AuditLog {
  id Int @id @default(autoincrement())

  adminId Int?   @map("admin_id")
  admin   Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  userId  Int?   @map("user_id")
  user    User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  action    AuditAction
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
