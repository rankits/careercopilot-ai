enum JobStatus {
  ACTIVE
  EXPIRED
  REMOVED
}

enum ProviderType {
  GREENHOUSE
  LEVER
  ARBEITNOW
  PUBLIC_FEED
  REMOTIVE
  JOBICY
  HIMALAYAS
  REMOTEOK
  REMOTEJOBS_ORG
  ASHBY
  RECRUITEE
  PERSONIO
}

model Company {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  logoUrl   String?  @map("logo_url")
  industry  String?
  size      String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jobs Job[]

  @@index([slug, verified])
  @@map("companies")
}

model Job {
  id                String    @id @default(uuid())
  canonicalHash     String    @unique @map("canonical_hash")
  companySlug       String    @map("company_slug")
  title             String
  employmentType    String?   @map("employment_type")
  remoteType        String?   @map("remote_type")
  descriptionHtml   String    @map("description_html") @db.Text
  descriptionText   String    @map("description_text") @db.Text
  salaryMin         Float?    @map("salary_min")
  salaryMax         Float?    @map("salary_max")
  currency          String?   @db.VarChar(10)
  skills            Json      @default("[]")
  benefits          Json      @default("[]")
  tags              Json      @default("[]")
  providerMetadata  Json      @default("{}") @map("provider_metadata")
  status            JobStatus @default(ACTIVE)
  version           Int       @default(1)
  firstSeen         DateTime  @default(now()) @map("first_seen")
  lastSeen          DateTime  @updatedAt @map("last_seen")
  lastChecked       DateTime  @default(now()) @map("last_checked")
  postedAt          DateTime? @map("posted_at")
  effectivePostedAt DateTime? @map("effective_posted_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  company                Company                  @relation(fields: [companySlug], references: [slug], onDelete: Cascade)
  sources                JobSource[]
  embeddings             JobEmbedding[]
  recommendations        JobRecommendation[]
  recommendationFeedback RecommendationFeedback[]

  @@index([status, lastSeen])
  @@index([companySlug, title])
  // Public listing: ACTIVE + newest / salary sorts and common filters (JOB-DB-001).
  @@index([status, createdAt(sort: Desc)])
  @@index([status, salaryMax(sort: Desc)])
  @@index([status, salaryMin])
  @@index([status, remoteType])
  @@index([status, employmentType])
  // Age-policy queries: storage-age and embedding-age cutoffs both filter on this index (JOB-AGE-POLICY-001).
  @@index([status, effectivePostedAt])
  @@map("jobs")
}

model JobSource {
  id            String       @id @default(uuid())
  jobId         String       @map("job_id")
  provider      ProviderType
  providerJobId String       @map("provider_job_id")
  priority      Int          @default(60) // Lever=100, Greenhouse=90, Arbeitnow=60
  applyUrl      String?      @map("apply_url")
  rawMetadata   Json         @default("{}") @map("raw_metadata")
  createdAt     DateTime     @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([provider, providerJobId])
  @@index([jobId, priority(sort: Desc)])
  @@map("job_sources")
}

model RawJob {
  id            String       @id @default(uuid())
  provider      ProviderType
  providerJobId String       @map("provider_job_id")
  version       Int          @default(1)
  payload       Json
  checksum      String
  fetchedAt     DateTime     @default(now()) @map("fetched_at")

  @@unique([provider, providerJobId, version])
  @@index([checksum])
  @@index([provider, providerJobId])
  @@map("raw_jobs")
}

model AggregationRun {
  id                   String       @id @default(uuid())
  provider             ProviderType
  status               String
  jobsFetched          Int          @default(0) @map("jobs_fetched")
  jobsInserted         Int          @default(0) @map("jobs_inserted")
  jobsUpdated          Int          @default(0) @map("jobs_updated")
  jobsSkippedUnchanged Int          @default(0) @map("jobs_skipped_unchanged")
  jobsFailed           Int          @default(0) @map("jobs_failed")
  durationMs           Int          @map("duration_ms")
  errors               Json?
  startedAt            DateTime     @map("started_at")
  completedAt          DateTime     @default(now()) @map("completed_at")

  @@index([provider, completedAt(sort: Desc)])
  @@map("aggregation_runs")
}

model ProviderHealth {
  provider            ProviderType @id
  successRate         Float        @default(100.0) @map("success_rate")
  failureRate         Float        @default(0.0) @map("failure_rate")
  avgResponseTimeMs   Int          @default(0) @map("avg_response_time_ms")
  consecutiveFailures Int          @default(0) @map("consecutive_failures")
  rateLimitRemaining  Int          @default(100) @map("rate_limit_remaining")
  circuitState        String       @default("HEALTHY") @map("circuit_state")
  lastCheckedAt       DateTime     @default(now()) @map("last_checked_at")

  @@map("provider_health")
}

model FailedJob {
  id               String       @id @default(uuid())
  aggregationRunId String       @map("aggregation_run_id")
  provider         ProviderType
  providerJobId    String       @map("provider_job_id")
  payload          Json
  errorReason      String       @map("error_reason") @db.Text
  retryCount       Int          @default(0) @map("retry_count")
  failedAt         DateTime     @default(now()) @map("failed_at")

  @@index([provider, failedAt(sort: Desc)])
  @@map("failed_jobs")
}
