PORT=5001
BASE_URL="http://localhost:5001"
DATABASE_URL="postgresql://user:password@localhost:5432/careercopilot?schema=public"

# Authentication
JWT_ACCESS_SECRET="default_access_secret_for_development_change_in_production"
JWT_REFRESH_SECRET="default_refresh_secret_for_development_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Caching Layer (driver: redis | memory)
CACHE_DRIVER="redis"
REDIS_MODE="standalone" # standalone | sentinel | cluster
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX="careercopilot:"

# Sentinel configuration (if REDIS_MODE=sentinel)
# REDIS_SENTINELS="127.0.0.1:26379,127.0.0.1:26380"
# REDIS_SENTINEL_MASTER="mymaster"

# Cluster configuration (if REDIS_MODE=cluster)
# REDIS_CLUSTER_NODES="127.0.0.1:7000,127.0.0.1:7001"

# Messaging Layer (RabbitMQ)
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_USER="guest"
RABBITMQ_PASSWORD="guest"
# Logging
LOGGING_ENABLED=true
LOG_PRETTY=true
