NODE_ENV="development"
PORT=5001
BASE_URL="http://localhost:5001"
DATABASE_URL="postgresql://user:password@localhost:5432/careercopilot?schema=public"

# Authentication
JWT_ACCESS_SECRET="default_access_secret_for_development_change_in_production"
JWT_REFRESH_SECRET="default_refresh_secret_for_development_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_ISSUER="careercopilot-api"
JWT_AUDIENCE="careercopilot-client"

# CORS
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Caching Layer
CACHE_DRIVER="redis"
REDIS_MODE="standalone"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX="careercopilot:"

# Sentinel configuration
# REDIS_SENTINELS="127.0.0.1:26379,127.0.0.1:26380"
# REDIS_SENTINEL_MASTER="mymaster"

# Cluster configuration
# REDIS_CLUSTER_NODES="127.0.0.1:7000,127.0.0.1:7001"

# Messaging Layer (RabbitMQ)
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_USER="guest"
RABBITMQ_PASSWORD="guest"

# Transactional outbox relay
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LOCK_TIMEOUT_MS=60000
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_RETRY_BASE_DELAY_MS=5000

# Resume storage
RESUME_STORAGE_DRIVER="LOCAL"
RESUME_MAX_FILE_SIZE_MB=10
RESUME_LOCAL_STORAGE_DIR="./storage/resumes"
RESUME_S3_BUCKET=""
RESUME_S3_PREFIX="users"
AWS_REGION="us-east-1"

# Resume parser AI
PARSER_ENGINE="RULE_BASED"

# Logging
LOG_LEVEL="info"

# Mailer (SMTP) - defaults target a local Mailpit-style dev container
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME="CareerCopilot"
MAIL_FROM_ADDRESS="no-reply@careercopilot.dev"

# OTP / password / lockout / session tuning
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESEND_COUNT=20
PASSWORD_MIN_LENGTH=8
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_DURATION_MINUTES=15
REFRESH_TOKEN_MAX_SESSIONS=5
SHORT_SESSION_TTL_HOURS=24

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_REQUESTS=10
OTP_RATE_LIMIT_MAX_REQUESTS=5

# Default admin bootstrap (consumed by prisma/seed/admin.seed.ts)
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=
ADMIN_DEFAULT_FIRST_NAME="Platform"
ADMIN_DEFAULT_LAST_NAME="Admin"

# Feature flags
ENABLE_EMAIL_WORKER=true
# Global Auto Apply kill switch (PLAN/APPROVE/QUEUE/SUBMIT fail closed when false)
ENABLE_AUTO_APPLY=true
ENABLE_AUTO_APPLY_HEADLESS_SNAPSHOT=true
# Alpine backend image ships Chromium here:
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
# Serves Swagger UI at /api-docs - typically left on in dev, often disabled in production
ENABLE_SWAGGER=true

# Resume parser AI (consumed by modules/resumes/config/resume.config.ts)
AI_RESUME_PARSER_PROVIDER=google
AI_RESUME_PARSER_MODEL=gemini-2.0-flash
AI_RESUME_PARSER_TEMPERATURE=0
AI_RESUME_PARSER_MAX_RETRIES=2
AI_RESUME_ANALYSIS_PROVIDER=openrouter
AI_RESUME_ANALYSIS_MODEL=google/gemini-2.5-flash
AI_RESUME_ANALYSIS_FALLBACK_MODELS=google/gemini-2.0-flash-exp:free,google/gemma-3-27b-it:free,google/gemma-4-26b-a4b-it:free
AI_RESUME_ANALYSIS_MAX_TOKENS=2800
# Per-model HTTP timeout (ms). Stuck calls abort so Groq/other fallbacks can run.
AI_RESUME_ANALYSIS_TIMEOUT_MS=90000
GOOGLE_API_KEY=your_google_api_key_here
# Optional Gemini alias accepted by the factory
# GEMINI_API_KEY=
GROQ_API_KEY=your_groq_api_key_here
# Optional: second Groq key / comma list when primary is rate-limited or expired
# GROQ_API_KEY_2=
# GROQ_API_KEYS=
# OPENAI_API_KEY=
AI_RESUME_ANALYSIS_FALLBACK_PROVIDERS=groq,openai,google
AI_RESUME_ANALYSIS_GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter fallback (used when Gemini fails after one retry)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=60000

# Job embeddings (AI_EMBEDDING_PROVIDER: google | gemini | groq | openrouter)
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=768
AI_EMBEDDING_REQUEST_DIMENSIONS=
AI_EMBEDDING_TIMEOUT_MS=30000
AI_EMBEDDING_BATCH_SIZE=32
AI_EMBEDDING_BATCH_MAX_CHARACTERS=200000
AI_EMBEDDING_MAX_RETRIES=3
AI_EMBEDDING_DOCUMENT_PREFIX=
AI_EMBEDDING_QUERY_PREFIX=
GOOGLE_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_EMBEDDING_BASE_URL=https://api.groq.com/openai/v1
# Shared OpenRouter (job embedding worker / default)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Career Copilot
OPENROUTER_ALLOW_FALLBACKS=
OPENROUTER_PROVIDER_ORDER=
OPENROUTER_DATA_COLLECTION_POLICY=
# Recommendation query embeddings — prefers these over shared OPENROUTER_* when set
OPENROUTER_RECOMMENDATION_API_KEY=
OPENROUTER_RECOMMENDATION_BASE_URL=
OPENROUTER_RECOMMENDATION_HTTP_REFERER=
OPENROUTER_RECOMMENDATION_APP_TITLE=
OPENROUTER_RECOMMENDATION_ALLOW_FALLBACKS=
OPENROUTER_RECOMMENDATION_PROVIDER_ORDER=
OPENROUTER_RECOMMENDATION_DATA_COLLECTION_POLICY=
JOB_EMBEDDING_DOCUMENT_SCHEMA_VERSION=1
JOB_EMBEDDING_BACKFILL_BATCH_SIZE=100

# Job age & retention policies (storage and embedding windows are independent)
# Storage filter: jobs older than this are not persisted / not listed
JOB_STORAGE_AGE_FILTER_ENABLED=true
JOB_STORAGE_MAX_AGE_DAYS=90
# Embedding/recommendation filter: must be <= storage days when both filters are enabled
# Temporary default: 5 days (can raise toward 30 later)
JOB_EMBEDDING_AGE_FILTER_ENABLED=true
JOB_EMBEDDING_MAX_AGE_DAYS=5
# REJECT | ALLOW_STORAGE_ONLY | ALLOW — jobs with no resolvable effective date
JOB_UNKNOWN_DATE_POLICY=ALLOW_STORAGE_ONLY
# EXPIRE (set status=EXPIRED) | DELETE (hard delete) for storage retention cleanup
JOB_STORAGE_EXPIRED_ACTION=EXPIRE
JOB_REMOVE_OUTDATED_EMBEDDINGS=true
JOB_RETENTION_CLEANUP_BATCH_SIZE=500
JOB_EMBEDDING_CLEANUP_BATCH_SIZE=500

# Optional bulk ingestion on API server start (uses distributed lock; does not call HTTP)
JOB_INGESTION_ON_STARTUP_ENABLED=false
JOB_INGESTION_ON_STARTUP_DELAY_MS=5000
JOB_INGESTION_ON_STARTUP_FAIL_APPLICATION=false
JOB_INGESTION_ON_STARTUP_LOCK_TTL_SECONDS=1800
# Comma-separated provider names / tiers (optional; empty = all configured)
JOB_INGESTION_ON_STARTUP_PROVIDERS=
JOB_INGESTION_ON_STARTUP_ALLOWED_TIERS=

# Resume storage (driver: LOCAL | S3)
RESUME_STORAGE_DRIVER=LOCAL
PARSER_ENGINE=RULE_BASED
RESUME_MAX_FILE_SIZE_MB=10
RESUME_LOCAL_STORAGE_DIR=
RESUME_S3_BUCKET=
RESUME_S3_PREFIX=users
AWS_REGION=us-east-1

# Resume Builder / AI Analysis
# Parser: AI_RESUME_PARSER_PROVIDER + GOOGLE_API_KEY/GEMINI_API_KEY (or groq).
# Analysis order: Gemini 2.5 Flash (OpenRouter) → free Gemini/Gemma → Groq.
# openrouter/free is skipped by default (empty/safety responses). Set AI_RESUME_ANALYSIS_ALLOW_OPENROUTER_FREE=true to enable.
# If OpenRouter times out or is out of credits, analysis auto-falls back when those keys are set.
# Models: primary AI_RESUME_ANALYSIS_MODEL, then AI_RESUME_ANALYSIS_FALLBACK_MODELS (comma-separated).
# Shorthand qwen/qwen3 maps to qwen/qwen3-32b on OpenRouter.
