{
  "name": "careercopilot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "backend:lint": "npm --prefix backend run lint",
    "backend:lint:fix": "npm --prefix backend run lint:fix",
    "backend:typecheck": "npm --prefix backend run typecheck",
    "extension:dev": "npm --prefix extension run dev",
    "extension:build": "npm --prefix extension run build",
    "extension:lint": "npm --prefix extension run lint",
    "extension:lint:fix": "npm --prefix extension run lint:fix",
    "extension:typecheck": "npm --prefix extension run typecheck",
    "extension:test": "npm --prefix extension run test",
    "test": "npm --prefix frontend run test",
    "test:coverage": "npm --prefix frontend run test:coverage",
    "test:watch": "npm --prefix frontend run test:watch",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "lint": "npm --prefix frontend run lint",
    "lint:fix": "npm --prefix frontend run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm --prefix frontend run typecheck",
    "prepare": "husky",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run format:check && npm run build && npm run backend:typecheck && npm run backend:lint && npm run backend:build && npm run extension:typecheck && npm run extension:lint && npm run extension:build && npm run extension:test"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,jsx}": [
      "npm --prefix frontend run lint:fix --",
      "prettier --write"
    ],
    "backend/**/*.{ts,tsx,js,jsx}": [
      "npm --prefix backend run lint:fix --",
      "prettier --write"
    ],
    "*.{json,css,scss,md,yml,yaml}": [
      "prettier --write"
    ],
    "frontend/**/*.{json,css,scss,md,yml,yaml}": [
      "prettier --write"
    ],
    "backend/**/*.{json,css,scss,md,yml,yaml}": [
      "prettier --write"
    ],
    "extension/**/*.{ts,tsx,js,jsx}": [
      "npm --prefix extension run lint:fix --",
      "prettier --write"
    ],
    "extension/**/*.{json,css,scss,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
