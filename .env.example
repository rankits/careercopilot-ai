# Compose defaults
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=careercopilot_dev
# Leave blank for local/dev (no Redis AUTH). Set a strong value for production.
REDIS_PASSWORD=
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Backend defaults
NODE_ENV=development
PORT=5001
BASE_URL=http://backend:5001
APP_NAME=CareerCopilot
DATABASE_URL=postgresql://postgres:postgres_password@postgres:5432/careercopilot_dev?schema=public
JWT_ACCESS_SECRET=dev_access_secret_change_in_production
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=careercopilot-api
JWT_AUDIENCE=careercopilot-client
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
CACHE_DRIVER=redis
REDIS_MODE=standalone
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_KEY_PREFIX=careercopilot:
# REDIS_SENTINELS=127.0.0.1:26379,127.0.0.1:26380
# REDIS_SENTINEL_MASTER=mymaster
# REDIS_CLUSTER_NODES=127.0.0.1:7000,127.0.0.1:7001
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LOCK_TIMEOUT_MS=60000
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_RETRY_BASE_DELAY_MS=5000
LOGGING_ENABLED=true
LOG_PRETTY=true
LOG_LEVEL=info
RESUME_STORAGE_DRIVER=LOCAL
RESUME_MAX_FILE_SIZE_MB=10
RESUME_LOCAL_STORAGE_DIR=/app/storage/resumes
RESUME_S3_BUCKET=
RESUME_S3_PREFIX=users
AWS_REGION=us-east-1
RUN_MIGRATIONS=true
RUN_SEEDS_ON_STARTUP=false
PARSER_ENGINE=RULE_BASED
AI_RESUME_PARSER_PROVIDER=google
AI_RESUME_PARSER_MODEL=gemini-3.5-flash
AI_RESUME_PARSER_TEMPERATURE=0
AI_RESUME_PARSER_MAX_RETRIES=2

# Mailer (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=CareerCopilot
MAIL_FROM_ADDRESS=no-reply@careercopilot.dev

# Auth / OTP / session tuning
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESEND_COUNT=20
PASSWORD_MIN_LENGTH=8
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_DURATION_MINUTES=15
REFRESH_TOKEN_MAX_SESSIONS=5
SHORT_SESSION_TTL_HOURS=24

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_REQUESTS=10
OTP_RATE_LIMIT_MAX_REQUESTS=5

# Feature flags / admin bootstrap
ENABLE_EMAIL_WORKER=true
ENABLE_SWAGGER=true
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=
ADMIN_DEFAULT_FIRST_NAME=Platform
ADMIN_DEFAULT_LAST_NAME=Admin

# Frontend defaults
COMPOSE_PROFILES=
VITE_API_BASE_URL=http://localhost:5001/api/v1
VITE_APP_NAME=CareerCopilot
VITE_DEV_PROXY_TARGET=http://backend:5001

# Secrets used only when the corresponding AI provider is enabled
GOOGLE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Provider-neutral job embeddings (provider: google | gemini | groq)
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=768
AI_EMBEDDING_TIMEOUT_MS=30000
AI_EMBEDDING_BATCH_SIZE=32
AI_EMBEDDING_DOCUMENT_PREFIX=
AI_EMBEDDING_QUERY_PREFIX=
GOOGLE_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_EMBEDDING_BASE_URL=https://api.groq.com/openai/v1
JOB_EMBEDDING_DOCUMENT_SCHEMA_VERSION=1
JOB_EMBEDDING_BACKFILL_BATCH_SIZE=100
