# ==============================================================================
# Career Copilot Backend Production Environment Configuration Schema (.env.example)
# This file defines the required schema and categories for production deployment.
# Copy this file to /opt/career-copilot/backend/shared/.env on the EC2 host and
# populate it with real production credentials. Never commit real values to Git.
# ==============================================================================

# --- 1. Application Runtime ---
NODE_ENV=production
PORT=5001
BASE_URL=https://api.example.com
APP_NAME=CareerCopilot
LOG_LEVEL=info
BACKEND_IMAGE=career-copilot-backend:latest

# --- 2. Database (PostgreSQL / Prisma with pgvector on RDS) ---
# Format: postgresql://<user>:<password>@<rds-endpoint>:5432/<dbname>?sslmode=require
DATABASE_URL=
RUN_MIGRATIONS=false
RUN_SEEDS_ON_STARTUP=false

# --- 3. Caching Layer (Redis) ---
CACHE_DRIVER=redis
REDIS_MODE=standalone
REDIS_HOST=10.0.1.10
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=careercopilot:

# --- 4. Messaging Layer (RabbitMQ) ---
# Format: amqp://<user>:<password>@<rabbitmq-host>:5672
RABBITMQ_URL=

# --- 5. JWT / Authentication ---
# Must be strong, non-default secrets (>= 32 characters in production)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=careercopilot-api
JWT_AUDIENCE=careercopilot-client
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESEND_COUNT=20
PASSWORD_MIN_LENGTH=8
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_DURATION_MINUTES=15
REFRESH_TOKEN_MAX_SESSIONS=5
SHORT_SESSION_TTL_HOURS=24

# --- 6. Email (SMTP Mailer) ---
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=CareerCopilot
MAIL_FROM_ADDRESS=no-reply@example.com

# --- 7. AI Providers & Models ---
GOOGLE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEYS=
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_FALLBACK=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=60000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_RESUME_PARSER_PROVIDER=google
AI_RESUME_PARSER_MODEL=gemini-2.0-flash
AI_RESUME_PARSER_TEMPERATURE=0.2
AI_RESUME_PARSER_MAX_RETRIES=2
AI_RESUME_ANALYSIS_PROVIDER=google
AI_RESUME_ANALYSIS_MODEL=gemini-2.0-flash
AI_RESUME_ANALYSIS_FALLBACK_PROVIDERS=openrouter,openai
AI_RESUME_ANALYSIS_TIMEOUT_MS=90000
AI_RESUME_ANALYSIS_FREE_TIMEOUT_MS=35000
AI_RESUME_ANALYSIS_STALE_MS=240000

# --- 8. Embedding Configuration ---
# Cloud providers remain supported. EC2 Compose overrides to local-http and
# points AI_EMBEDDING_BASE_URL at the private embedding-service container.
# AI_EMBEDDING_PROVIDER: google | gemini | groq | openrouter | local-http
AI_EMBEDDING_PROVIDER=local-http
AI_EMBEDDING_BASE_URL=http://embedding-service:8080/v1
AI_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
AI_EMBEDDING_DIMENSIONS=768
AI_EMBEDDING_TIMEOUT_MS=60000
AI_EMBEDDING_BATCH_SIZE=16
JOB_EMBEDDING_DOCUMENT_SCHEMA_VERSION=1.0

# Embedding container (Compose / shared deploy config — not secrets)
EMBEDDING_IMAGE=<username>/career-copilot-embedding:<version>
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIMENSIONS=768
EMBEDDING_MAX_BATCH_SIZE=16
# Keep below EC2 free RAM after api (384m) + outbox (160m) + OS.
EMBEDDING_MEMORY_LIMIT=1536m
EMBEDDING_CPU_LIMIT=1.0

# --- 9. Job Ingestion & Retention Policies ---
JOB_INGESTION_ON_STARTUP_ENABLED=false
JOB_INGESTION_ON_STARTUP_DELAY_MS=5000
JOB_INGESTION_ON_STARTUP_FAIL_APPLICATION=false
JOB_INGESTION_ON_STARTUP_LOCK_TTL_SECONDS=1800
JOB_INGESTION_ON_STARTUP_PROVIDERS=
JOB_INGESTION_ON_STARTUP_ALLOWED_TIERS=
JOB_STORAGE_AGE_FILTER_ENABLED=true
JOB_STORAGE_MAX_AGE_DAYS=90
JOB_EMBEDDING_AGE_FILTER_ENABLED=true
JOB_EMBEDDING_MAX_AGE_DAYS=5
JOB_UNKNOWN_DATE_POLICY=ALLOW_STORAGE_ONLY
JOB_STORAGE_EXPIRED_ACTION=EXPIRE
JOB_REMOVE_OUTDATED_EMBEDDINGS=true
JOB_RETENTION_CLEANUP_BATCH_SIZE=500
JOB_EMBEDDING_CLEANUP_BATCH_SIZE=500

# --- 10. Storage (AWS S3 for Resumes & Artifacts) ---
RESUME_STORAGE_DRIVER=S3
RESUME_S3_BUCKET=
RESUME_S3_PREFIX=users
AWS_REGION=ap-south-1
RESUME_LOCAL_STORAGE_DIR=/app/storage/resumes
RESUME_MAX_FILE_SIZE_MB=10
PARSER_ENGINE=RULE_BASED

# --- 11. Feature Flags ---
ENABLE_EMAIL_WORKER=true
# Include RabbitMQ in /health even when ENABLE_EMAIL_WORKER=false
HEALTH_CHECK_RABBITMQ=false
ENABLE_SWAGGER=false
ENABLE_RECOMMENDATION_RERANK=false

# --- 12. Worker & Outbox Settings ---
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LOCK_TIMEOUT_MS=60000
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_RETRY_BASE_DELAY_MS=5000

# --- 13. Rate Limiting ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_REQUESTS=10
OTP_RATE_LIMIT_MAX_REQUESTS=5
JOB_LISTING_RATE_LIMIT_WINDOW_MINUTES=1
JOB_LISTING_RATE_LIMIT_MAX_REQUESTS=60
RECOMMENDATION_RATE_LIMIT_WINDOW_MINUTES=15
RECOMMENDATION_RATE_LIMIT_MAX_REQUESTS=10
