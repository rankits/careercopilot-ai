# Career Copilot — local frontend manual deploy configuration
# Copy to deploy/frontend-manual-deploy.env and fill in real values.
# NEVER commit deploy/frontend-manual-deploy.env.
#
# Do NOT store:
#   - AWS access keys / secret keys
#   - application secrets
#
# Authenticate separately:
#   aws sso login --profile career-copilot
#   # or: aws configure --profile career-copilot

AWS_PROFILE=career-copilot
AWS_REGION=ap-south-1

FRONTEND_S3_BUCKET=<frontend-production-bucket>
CLOUDFRONT_DISTRIBUTION_ID=<distribution-id>
FRONTEND_PUBLIC_URL=https://<cloudfront-domain-or-custom-domain>

# Confirmed for this repo: Vite React app under frontend/, output dist/
FRONTEND_DIRECTORY=frontend
FRONTEND_BUILD_DIRECTORY=dist

# Baked into the production Vite build (safe to store; not AWS secrets)
VITE_API_BASE_URL=https://<backend-public-api-host>/api/v1
VITE_APP_NAME=CareerCopilot

# Optional
# WAIT_FOR_INVALIDATION=true
# FRONTEND_VERIFY_MARKER=id="root"
# FRONTEND_VERIFY_ATTEMPTS=12
# ALLOW_SOURCEMAPS=false
