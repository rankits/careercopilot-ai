# Career Copilot — local manual deploy configuration
# Copy to deploy/manual-deploy.env and fill in real values.
# NEVER commit deploy/manual-deploy.env.
#
# Do NOT store:
#   - AWS access keys / secret keys
#   - Docker Hub tokens
#   - Database credentials
#   - Application secrets / production .env contents
#
# Authenticate separately:
#   docker login
#   aws sso login --profile <profile>   # or: aws configure

AWS_REGION=ap-south-1
AWS_PROFILE=default

BACKEND_DEPLOYMENT_BUCKET=career-copilot-production-deployments-<id>
EC2_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx

# Optional display/helper only; image tag is always set by the script.
DOCKERHUB_USERNAME=<username>

# Repository only — do not include a tag (script appends :<VERSION>)
DOCKER_IMAGE_NAME=<username>/career-copilot-backend

PUBLIC_HEALTH_URL=http://<backend-public-ip>/health
