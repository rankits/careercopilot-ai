# Career Copilot embedding HTTP service
#
# Private Compose service only. Backend reaches it at:
#   http://embedding-service:8080/v1
#
# Required by backend when AI_EMBEDDING_PROVIDER=local-http.

EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIMENSIONS=768
EMBEDDING_SERVICE_PORT=8080
EMBEDDING_MODEL_CACHE=/models
EMBEDDING_MAX_BATCH_SIZE=32
EMBEDDING_LOG_LEVEL=info

# Optional resource guidance for Compose (EC2 must leave RAM for api + OS):
# EMBEDDING_MEMORY_LIMIT=1536m
# EMBEDDING_CPU_LIMIT=1.0
